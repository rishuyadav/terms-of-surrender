# Used by Docker Compose. For local Maven/Next.js runs, export backend variables
# in the shell; Next.js can read frontend/.env.local. Never commit real secrets.
DATABASE_PASSWORD=replace-with-a-long-random-local-password
WEB_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
SECURE_COOKIES=false
RETENTION_HOURS=24

# Optional OpenAI-compatible HTTPS provider. All three fields are required to opt in.
# Extracted text is sent to this provider without guaranteed anonymization.
MODEL_ENABLED=false
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
