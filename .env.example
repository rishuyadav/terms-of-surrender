# Used by Docker Compose. For local Maven/Next.js runs, export backend variables
# in the shell; Next.js can read frontend/.env.local. Never commit real secrets.
DATABASE_PASSWORD=replace-with-a-long-random-local-password
WEB_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
SECURE_COOKIES=false
RETENTION_HOURS=24

# Optional OpenAI-compatible HTTPS provider. All three fields are required to opt in.
# Extracted text is sent to this provider without guaranteed anonymization.
MODEL_ENABLED=false
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=

# Public Vercel -> Render demo. Keep false for unrestricted local AI development.
AI_DEMO_ENABLED=false
# Generate a stable random secret (32+ characters). Set the SAME value on Vercel
# and Render, server-side only. Never use a NEXT_PUBLIC_ variable.
AI_DEMO_PROXY_SECRET=
AI_DEMO_ANALYSES_PER_IP=5
AI_DEMO_QUESTIONS_PER_IP=8
AI_DEMO_MAX_CHARACTERS=30000
AI_DEMO_MAX_COMPLETION_TOKENS=4000
